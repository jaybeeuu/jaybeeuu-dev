{
  "name": "@jaybeeuu/posts",
  "version": "0.0.0",
  "author": "Josh Bickley-Wallace <joshbickleywallace@outlook.com> (https://github.com/jaybeeuu)",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "My blog posts",
  "keywords": [
    "Bickley-Wallace",
    "Josh",
    "Posts"
  ],
  "files": [
    "lib",
    "src"
  ],
  "exports": {
    "./manifest": {
      "default": "./lib/post-manifest.json"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./compost.config.ts": {
      "default": "./compost.config.ts"
    }
  },
  "scripts": {
    "build": "tsc --project ./tsconfig.build.json --pretty && compost --config ./compost.config.ts --old-manifest-locator \"https://jaybeeuu.dev/blog/manifest.json\"",
    "type-check": "tsc --noEmit --pretty",
    "lint": "markdownlint \"**/*.md\" --ignore node_modules",
    "spell-check-interactive": "mdspell --en-GB --ignore-numbers \"**/*.md\" \"!**/node_modules/**/*.md\"",
    "spell-check": "pnpm run spell-check-interactive --report",
    "start": "compost --config ./compost.config.ts --watch --include-unpublished --old-manifest-locator \"https://jaybeeuu.dev/blog/manifest.json\""
  },
  "devDependencies": {
    "@jaybeeuu/compost": "workspace:*",
    "@jaybeeuu/is": "workspace:*",
    "@types/node": "^24.3.0",
    "@types/yargs": "^17.0.33",
    "markdown-spellcheck": "^1.3.1",
    "markdownlint": "^0.38.0",
    "markdownlint-cli": "^0.45.0",
    "nodemon": "^3.1.10",
    "reading-time": "^1.5.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "yargs": "^18.0.0"
  }
}
